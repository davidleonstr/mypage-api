# Copy this file to .env and fill it in. .env is git-ignored.

# Admin panel login (HTTP Basic). The API refuses to start if PASSWORD is empty
# or still "change-me".
USER=admin
PASSWORD=change-me

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Front-end origins allowed to call the API (comma separated, exact match).
# Not needed when the site and the API share one domain behind a reverse proxy.
CORS_ORIGINS=http://localhost:5173

# Set to 1 when running behind nginx/Caddy so rate limits use the real client IP.
TRUST_PROXY=0
